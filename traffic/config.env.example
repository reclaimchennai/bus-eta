# Hosts the live traffic pipeline talks to. Nothing here is needed to read the published data.
# ssh target of the self-hosted Nitter box (twtrx pipeline/x_live.py reads ~/nitter/out/latest.json there when not local)
NITTER_SSH="-J user@jump-host -p 22 user@nitter-host"
NITTER_SSH_OPTS=""            # extra ssh options for scripts/mss_push_code.sh
NITTER_HOST=user@nitter-host
NITTER_LATEST=~/nitter/out/latest.json   # set when Nitter runs on the same machine
# ssh target that serves the bus maps (Chennai / Bengaluru / Delhi incident layers, BTP congestion profile)
MAP_SERVER=user@map-server
# ssh target that serves the state-RTC maps (TGSRTC incident layer)
PUBLISH_HOST=user@rtc-map-server
# Bengaluru Traffic Police congestion dashboard: the public "publish to web" key in the embed URL of
# btp.karnataka.gov.in/188/congestion-map (the k= parameter of app.powerbi.com/view?r=...)
BTP_POWERBI_KEY=
# WhatsApp channel name read from WhatsApp Desktop's local DB (Mac only)
WA_CHANNEL="Cyberabad Traffic Pulse"
TWTRX_NO_PUSH=1               # 1 = build everything, push nothing
OSRM_URL=https://router.project-osrm.org
